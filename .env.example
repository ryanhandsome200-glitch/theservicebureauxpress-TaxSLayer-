# Public browser configuration only. Never put private keys, database URLs,
# payment secrets, or e-file credentials in VITE_ variables.

# Display name shown in the header and the browser title.
VITE_APP_NAME=theservicebureauxpress TaxSLayer

# development uses the in-memory sandbox. production refuses to store returns
# unless VITE_API_BASE_URL points at the separately deployed backend.
VITE_DATA_MODE=development

# Origin of the secure API, for example https://api.example.com
# Leave blank in the local sandbox. This value is visible in the browser.
VITE_API_BASE_URL=

# Optional public identity-provider origin and publishable key.
VITE_AUTH_PUBLIC_URL=
VITE_AUTH_PUBLIC_KEY=

# Local administrator bootstrap. Must stay false on any deployed environment.
VITE_DEV_ALLOW_ADMIN_BOOTSTRAP=false
